@inproceedings{wang_trajectory_2024,
	location = {Kunming, China},
	title = {Trajectory Tracking Control of Quadrotors via Robust Control Barrier Function},
	rights = {https://doi.org/10.15223/policy-029},
	isbn = {978-988-758-158-1},
	url = {https://ieeexplore.ieee.org/document/10662043/},
	doi = {10.23919/CCC63176.2024.10662043},
	abstract = {Quadcopters are widely utilized in industries such as aerial photography, surveillance, cinematography, and transportation due to their simple structure and ease of takeoff and landing, which have become the preferred choice for smallscale aircraft in the civil aviation sector. However, ensuring safety control for these inherently unstable systems is crucial. Imposing multiple dynamic constraints to achieve safe regulation poses a challenging problem. In this paper, we propose a Quadratic Programming ({QP})-based filtering approach to enhance safety. We explicitly consider the nonlinear underactuated dynamics of quadcopters and utilize Control Barrier Functions ({CBFs}) in cascaded controller to construct safety regions. We demonstrate the preservation of safety and stability in quadcopter motion within the {SE}(3) space. Additionally, we introduce unknown disturbances during the motion and employ a robust controller to ensure the system maintains safety and stability.},
	eventtitle = {2024 43rd Chinese Control Conference ({CCC})},
	pages = {2239--2244},
	booktitle = {2024 43rd Chinese Control Conference ({CCC})},
	publisher = {{IEEE}},
	author = {Wang, Yulu},
	urldate = {2024-10-17},
	date = {2024-07-28},
	langid = {english},
	file = {PDF:/Users/colingrund/Zotero/storage/47Y6RRCC/Wang - 2024 - Trajectory Tracking Control of Quadrotors via Robust Control Barrier Function.pdf:application/pdf},
}

@article{keyumarsi_lidar-based_2024,
	title = {{LiDAR}-Based Online Control Barrier Function Synthesis for Safe Navigation in Unknown Environments},
	volume = {9},
	issn = {2377-3766},
	url = {https://ieeexplore.ieee.org/document/10339852/?arnumber=10339852},
	doi = {10.1109/LRA.2023.3339059},
	abstract = {This letter presents a novel extension of the control barrier function ({CBF}) as the low-level safety controller for autonomous mobile robots navigating in unknown environments. The main challenges of implementing {CBF} in real-world situations arise from the absence of a model or the lack of an exact one for the environment. Additionally, online learning is needed for the robot to maneuver in an unknown environment which leads to dealing with the sampled data set size, memory, and computational complexity. We address these challenges by designing an online non-parametric {LiDAR}-based safety function using the Gaussian process ({GP}). It is both efficient in data size and eliminates the requirement to store previous data. Then, a {CBF} is synthesized using the proposed safety function to rectify the safe control input. The effectiveness of the {LiDAR}-based {CBF} synthesis for navigation in unknown environments was validated by conducting experiments on unicycle-type robots.},
	pages = {1043--1050},
	number = {2},
	journaltitle = {{IEEE} Robotics and Automation Letters},
	author = {Keyumarsi, Shaghayegh and Atman, Made Widhi Surya and Gusrialdi, Azwirman},
	urldate = {2024-10-17},
	date = {2024-02},
	note = {Conference Name: {IEEE} Robotics and Automation Letters},
	keywords = {Autonomous agents, Bayes methods, collision avoidance, Laser radar, machine learning for robot control, Mobile robots, Navigation, Robot sensing systems, Robots, Safety},
	file = {Full Text PDF:/Users/colingrund/Zotero/storage/JR8TVYAG/Keyumarsi et al. - 2024 - LiDAR-Based Online Control Barrier Function Synthesis for Safe Navigation in Unknown Environments.pdf:application/pdf;IEEE Xplore Abstract Record:/Users/colingrund/Zotero/storage/WWE9ZESC/10339852.html:text/html},
}

@inproceedings{lo_lidar-inertial_2023,
	title = {Lidar-Inertial Based Localization and Collision Avoidance in Unmanned Vehicles via Control Barrier Functions},
	url = {https://ieeexplore.ieee.org/document/10325862},
	doi = {10.1109/CACS60074.2023.10325862},
	abstract = {To enhance localization reliability, we apply tightly-coupled methods that improve estimation precision through sensor integration, enabling real-time spatial awareness. To tackle realtime collision avoidance with unknown obstacles in the environment, we utilize Control Barrier Functions ({CBFs}) to ensure a safe distance is maintained between the vehicle and obstacles, allowing secure missions in dynamic environments. The integration of {CBF} with localization and path planning significantly enhances overall safety and enables real-time obstacle avoidance for unmanned vehicle navigation, particularly in scenarios with unforeseen obstacles. The proposed framework dynamically adjusts vehicle commands to avoid collisions, ensuring both reliable and safe operations. Simulations were conducted to verify the effectiveness of the developed controller.},
	eventtitle = {2023 International Automatic Control Conference ({CACS})},
	pages = {1--6},
	booktitle = {2023 International Automatic Control Conference ({CACS})},
	author = {Lo, Huai-Chien and Hsu, Yen-Cheng and Cheng, Teng-Hu},
	urldate = {2024-10-21},
	date = {2023-10},
	note = {{ISSN}: 2473-7259},
	keywords = {Collision avoidance, Control barrier function, {LIDAR}-inertial odometry, Location awareness, navigation, Navigation, Path planning, Real-time systems, Robot sensing systems, Safety, Sensor fusion},
	file = {Full Text PDF:/Users/colingrund/Zotero/storage/PGSPZXVP/Lo et al. - 2023 - Lidar-Inertial Based Localization and Collision Avoidance in Unmanned Vehicles via Control Barrier F.pdf:application/pdf;IEEE Xplore Abstract Record:/Users/colingrund/Zotero/storage/KP67AATK/10325862.html:text/html},
}

